/// Καλλικράτης: δενδροειδής διοικητική διαίρεση (πηγή: prisma/data/kallikratis.json).
/// level 3 = Περιφέρεια, 4 = Περιφερειακή Ενότητα (νομός), 5 = Δήμος.
/// Ο κωδικός δείχνει την ιεραρχία: «111» → «11102» → «1110202».
model Region {
  code       String   @id
  nameEL     String
  nameEN     String?
  level      Int // 3 | 4 | 5
  parentCode String?
  parent     Region?  @relation("RegionTree", fields: [parentCode], references: [code], onDelete: SetNull)
  children   Region[] @relation("RegionTree")
  path       String? // «111>11102>1110202»
  latitude   Float?
  longitude  Float?
  active     Boolean  @default(true)
  districts  District[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([parentCode])
  @@index([level])
  @@index([nameEL])
}

/// Δεύτερος παράγοντας για το προσωπικό: μετά τον σωστό κωδικό στέλνεται OTP
/// στο email και η συνεδρία δημιουργείται μόνο αφού επαληθευτεί. Ο κωδικός
/// αποθηκεύεται ως hash· κρατάμε τεκμήρια (IP, browser) όπως στα login events.
model StaffLoginChallenge {
  id         String    @id @default(cuid())
  staffId    String
  staff      Staff     @relation(fields: [staffId], references: [id], onDelete: Cascade)
  email      String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  sent       Boolean   @default(false) // αν έφυγε πράγματι το email
  usedAt     DateTime?
  ip         String?
  ipHash     String?
  userAgent  String?
  createdAt  DateTime  @default(now())

  @@index([staffId, createdAt])
  @@index([expiresAt])
}
