// Euronics commerce core — no intermediate e-commerce platform.
// The ERP stays the source of truth for items, prices, stock and documents;
// this schema is the web mirror + everything the ERP does not model
// (zones, widgets, guides, consents, reviews, sessions).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Catalogue (mirrored from the ERP) ----------

model Category {
  id        String     @id @default(cuid())
  erpCode   String?    @unique
  slug      String     @unique
  name      String
  parentId  String?
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")
  depth     Int        @default(0)
  sortNo    Int        @default(0)
  metaTitle String?
  metaDesc  String?    @db.Text
  products  Product[]
  facets    Facet[]

  @@index([parentId])
}

model Brand {
  id       String    @id @default(cuid())
  slug     String    @unique
  name     String
  logo     String?
  products Product[]
}

model Product {
  id          String       @id @default(cuid())
  erpCode     String       @unique // MTRL / item code
  slug        String       @unique
  sku         String       @unique
  ean         String?
  title       String
  brandId     String
  brand       Brand        @relation(fields: [brandId], references: [id])
  categoryId  String
  category    Category     @relation(fields: [categoryId], references: [id])
  description String?      @db.Text
  highlights  Json?
  vatRate     Decimal      @default(24) @db.Decimal(5, 2)
  isRenew     Boolean      @default(false)
  renewGrade  String? // A | B
  active      Boolean      @default(true)
  variants    Variant[]
  media       Media[]
  specs       Spec[]
  energy      EnergyLabel?
  reviews     Review[]
  questions   Question[]
  tags        ProductTag[]
  updatedAt   DateTime     @updatedAt
  createdAt   DateTime     @default(now())

  @@index([categoryId, active])
  @@index([brandId])
}

model Variant {
  id         String       @id @default(cuid())
  productId  String
  product    Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  erpCode    String       @unique
  axis       Json // { color: "Deep Blue", capacity: "256GB" }
  price      Decimal      @db.Decimal(10, 2)
  wasPrice   Decimal?     @db.Decimal(10, 2)
  /// Omnibus: lowest price of the previous 30 days, maintained by PriceHistory
  lowest30   Decimal?     @db.Decimal(10, 2)
  prices     PriceHistory[]
  stock      StoreStock[]
  cartLines  CartLine[]
  orderLines OrderLine[]
  updatedAt  DateTime     @updatedAt

  @@index([productId])
}

model PriceHistory {
  id        String   @id @default(cuid())
  variantId String
  variant   Variant  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  price     Decimal  @db.Decimal(10, 2)
  from      DateTime
  to        DateTime?

  @@index([variantId, from])
}

model StoreStock {
  variantId String
  storeId   String
  variant   Variant  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  qty       Int
  updatedAt DateTime @updatedAt

  @@id([variantId, storeId])
  @@index([storeId])
}

model Media {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  kind      String // image | video | manual | fiche
  url       String
  alt       String?
  sortNo    Int     @default(0)

  @@index([productId])
}

model Spec {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  groupName String
  key       String
  value     String
  sortNo    Int     @default(0)

  @@index([productId])
}

model EnergyLabel {
  productId String  @id
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  class     String // A+++ … G
  scale     String // "A-G" | "A+++-D"
  eprelId   String?
  labelUrl  String?
  ficheUrl  String?
}

/// Facet definitions per category: which specs become filters and how they map to URL params.
model Facet {
  id         String   @id @default(cuid())
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  key        String
  label      String
  param      String
  kind       String // checkbox | range | boolean
  sortNo     Int      @default(0)

  @@unique([categoryId, param])
}

model Tag {
  id       String       @id @default(cuid())
  slug     String       @unique
  name     String
  products ProductTag[]
}

model ProductTag {
  productId String
  tagId     String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
}

model Review {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  customerId String?
  rating    Int
  title     String?
  body      String   @db.Text
  verified  Boolean  @default(false)
  status    String   @default("pending")
  createdAt DateTime @default(now())

  @@index([productId, status])
}

model Question {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  body      String   @db.Text
  answer    String?  @db.Text
  status    String   @default("pending")
  createdAt DateTime @default(now())

  @@index([productId, status])
}

// ---------- Network & services ----------

model Store {
  id        String       @id @default(cuid())
  siteId    Int?         @unique // euronics.gr store-locator id (source of the import)
  erpBranch String?      @unique
  slug      String       @unique
  name      String
  member    String? // cooperative member company
  kind      String? // "ΚΑΤΑΣΤΗΜΑ ΗΛΕΚΤΡΙΚΩΝ & ΗΛΕΚΤΡΟΝΙΚΩΝ ΕΙΔΩΝ" as published
  address   String
  city      String
  region    String
  regionRaw String? // as published (genitive)
  zip       String
  phone     String?
  mobile    String?
  fax       String?
  email     String?
  lat       Float
  lng       Float
  geocoded  String? // "site" | "manual" | "nominatim"
  geoLat    Float?  // independent geocode (Nominatim) for QA
  geoLng    Float?
  geoDeltaKm Float? // distance between published and geocoded point
  geoLabel  String? // display name returned by the geocoder
  hours     Json // [{ day: 1, open: "09:00", close: "21:00" }]
  services  Json // ["click-collect", "installation", "service-point", …]
  photo     String? // media asset URL
  notes     String?      @db.Text
  active    Boolean      @default(true)
  sort      Int          @default(0)
  stock     StoreStock[]
  orders    Order[]
  customers Customer[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([region])
  @@index([active])
}

model Service {
  id         String  @id @default(cuid())
  slug       String  @unique
  no         Int
  title      String
  blurb      String
  body       String? @db.Text
  priceFrom  Decimal? @db.Decimal(10, 2)
  /// Where the service is offered as an add-on: pdp | checkout | delivery
  addonAt    Json?
  faq        Json?
  active     Boolean @default(true)
  orderLines OrderLineAddon[]
}

// ---------- Customers, carts, orders ----------

/// Retail customer (e-shop account). Mirrors SoftOne CUSTOMER (TRDR) through erpTrdr/erpCode; the shop is the master for
/// consents, devices, loyalty events and notes, the ERP is the master for fiscal identity (ΑΦΜ/ΔΟΥ) once linked.
model Customer {
  id            String         @id @default(cuid())
  number        Int            @unique @default(autoincrement()) // shop customer number → ERP CODE "<prefix><number>"
  type          String         @default("individual") // individual | business
  email         String         @unique
  emailVerifiedAt DateTime?
  phone         String?
  mobile        String?
  firstName     String
  lastName      String
  company       String? // legal name for business customers
  vatNumber     String? // ΑΦΜ
  doy           String? // Δ.Ο.Υ.
  profession    String?
  birthday      DateTime?
  gender        String? // m | f | other | null
  locale        String         @default("el")
  status        String         @default("active") // active | blocked | anonymised
  source        String         @default("web") // web | store | erp | import
  tags          String[]       @default([])
  newsletter    Boolean        @default(false)
  passwordHash  String?
  lastLoginAt   DateTime?
  preferredStoreId String?
  preferredStore Store?        @relation(fields: [preferredStoreId], references: [id], onDelete: SetNull)
  loyaltyPoints Int            @default(0)
  loyaltyTier   String? // bronze | silver | gold
  loyaltyCard   String? // ERP TRDRBONUSCARD / physical card number
  // ERP link (SoftOne CUSTOMER / TRDR)
  erpTrdr       String?        @unique
  erpCode       String?
  erpSyncStatus String? // linked | queued | sent | failed | conflict
  erpSyncedAt   DateTime?
  erpLastError  String?        @db.Text
  notes         String?        @db.Text // internal
  anonymisedAt  DateTime?
  addresses     Address[]
  cards         SavedCard[]
  consents      Consent[]
  wishlists     WishlistList[]
  orders        Order[]
  carts         Cart[]
  social        SocialAccount[]
  devices       CustomerDevice[]
  tickets       ServiceTicket[]
  loyalty       LoyaltyTransaction[]
  customerNotes CustomerNote[]
  events        CustomerEvent[]
  logins        LoginEvent[]
  gdprRequests  GdprRequest[]
  subscriptions NewsletterSubscriber[]
  passwordResets PasswordReset[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([lastName, firstName])
  @@index([vatNumber])
  @@index([status])
  @@index([erpSyncStatus])
}

/// Social login identities (Google / Microsoft / Facebook / Apple).
model SocialAccount {
  id                String   @id @default(cuid())
  customerId        String
  customer          Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  provider          String
  providerAccountId String
  email             String?
  createdAt         DateTime @default(now())

  @@unique([provider, providerAccountId])
  @@index([customerId])
}

/// Delivery / billing addresses. Extra addresses map to SoftOne CUSBRANCH lines (erpBranch = LINENUM).
model Address {
  id          String   @id @default(cuid())
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label       String? // Σπίτι, Γραφείο…
  kind        String   @default("shipping") // shipping | billing | both
  recipient   String?
  street      String
  number      String?
  floor       String?
  doorbell    String?
  city        String
  zip         String
  region      String
  country     String   @default("GR")
  phone       String?
  notes       String? // access, elevator, appointment hints
  lat         Float?
  lng         Float?
  isDefault   Boolean  @default(false)
  isBilling   Boolean  @default(false)
  erpBranch   Int? // CUSBRANCH.LINENUM
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([customerId])
}

model SavedCard {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  psp        String
  token      String
  last4      String
  brand      String
  expMonth   Int
  expYear    Int
  isDefault  Boolean  @default(false)

  @@index([customerId])
}

/// GDPR consent ledger (art. 7 — burden of proof): one immutable row per change with the full evidence of how the
/// consent was obtained. Rows are never updated or deleted; erasure pseudonymises the customer, not the ledger.
model Consent {
  id           String    @id @default(cuid())
  customerId   String?
  customer     Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  subscriberId String?
  subscriber   NewsletterSubscriber? @relation(fields: [subscriberId], references: [id], onDelete: SetNull)
  email        String? // as given at the time (kept for proof even after erasure? no — hashed on erasure)
  topic        String // newsletter | offers | price-drop | back-in-stock | service | orders | cookies-analytics | cookies-marketing | geolocation | profiling | terms | privacy
  channel      String    @default("email") // email | sms | push | viber | phone | web
  granted      Boolean
  method       String    @default("checkbox") // checkbox | double-opt-in | account-toggle | admin | import | store-form | popup
  source       String // checkout | account | footer | popup | admin | import | store | api
  textKey      String? // ConsentText.key
  textVersion  String? // ConsentText.version shown
  textHash     String? // sha256 of the exact wording shown
  url          String?
  ip           String?
  ipHash       String? // sha256(ip + salt) survives erasure
  userAgent    String?
  os           String?
  browser      String?
  device       String? // desktop | mobile | tablet
  locale       String?
  timezone     String?
  referer      String?
  confirmedAt  DateTime? // double opt-in confirmation
  confirmIp    String?
  evidence     Json? // form snapshot / extra proof
  staffId      String? // when changed by staff
  at           DateTime  @default(now())

  @@index([customerId, topic, channel])
  @@index([email])
  @@index([at])
}

/// Versioned consent wordings — every consent row points to the exact text (key + version + hash) that was shown.
model ConsentText {
  id            String   @id @default(cuid())
  key           String // newsletter | offers | terms | privacy | cookies | service
  version       String // "2026-09"
  locale        String   @default("el")
  title         String
  text          String   @db.Text
  hash          String // sha256(text)
  effectiveFrom DateTime @default(now())
  active        Boolean  @default(true)
  createdBy     String?
  createdAt     DateTime @default(now())

  @@unique([key, version, locale])
  @@index([key, active])
}

/// Every authentication attempt (customers and staff) with device evidence — accountability + security.
model LoginEvent {
  id         String    @id @default(cuid())
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  staffId    String?
  email      String // attempted identifier
  success    Boolean
  method     String // password | google | microsoft | facebook | apple | magic-link | admin
  reason     String? // bad-password | unknown | blocked | no-access
  ip         String?
  ipHash     String?
  userAgent  String?
  os         String?
  browser    String?
  device     String?
  country    String?
  city       String?
  sessionId  String?
  at         DateTime  @default(now())

  @@index([customerId, at])
  @@index([staffId, at])
  @@index([email, at])
}

/// Newsletter audience with double opt-in and proof of every status change (see Consent rows with subscriberId).
model NewsletterSubscriber {
  id             String    @id @default(cuid())
  email          String    @unique
  customerId     String?
  customer       Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  firstName      String?
  status         String    @default("pending") // pending | subscribed | unsubscribed | bounced | complained
  source         String    @default("footer") // footer | checkout | account | popup | store | import | admin
  lists          String[]  @default(["general"])
  locale         String    @default("el")
  token          String    @unique @default(cuid()) // confirm / unsubscribe link token
  confirmedAt    DateTime?
  unsubscribedAt DateTime?
  unsubscribeReason String?
  bouncedAt      DateTime?
  externalId     String? // Mailchimp / Klaviyo id
  syncedAt       DateTime?
  consents       Consent[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status])
  @@index([customerId])
}

/// Data-subject requests (GDPR arts. 15–21): tracked with the 30-day deadline and what was done.
model GdprRequest {
  id           String    @id @default(cuid())
  number       String    @unique // GDPR-00001
  customerId   String?
  customer     Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  email        String
  type         String // access | portability | rectification | erasure | restriction | objection | withdraw-consent
  status       String    @default("open") // open | verifying | in-progress | done | rejected
  channel      String    @default("account") // account | email | phone | store | letter | admin
  description  String?   @db.Text
  identityVerifiedAt DateTime?
  identityMethod String? // login | id-document | email-link | in-person
  requestedAt  DateTime  @default(now())
  dueAt        DateTime // requestedAt + 30 days (art. 12.3)
  completedAt  DateTime?
  outcome      String?   @db.Text // what was delivered / why rejected
  exportUrl    String?
  staffId      String?
  evidence     Json? // ip / ua of the request when self-service
  timeline     Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status, dueAt])
  @@index([customerId])
}

/// Outgoing transactional email log (confirmations, GDPR exports, service) — proof of dispatch.
model EmailLog {
  id        String   @id @default(cuid())
  to        String
  subject   String
  template  String
  status    String   @default("queued") // queued | sent | failed | skipped
  provider  String?
  messageId String?
  error     String?  @db.Text
  meta      Json?
  at        DateTime @default(now())

  @@index([to, at])
}

/// Appliances the customer owns (warranty wallet). Filled from order lines, store purchases (ERP) or manual registration.
model CustomerDevice {
  id             String    @id @default(cuid())
  customerId     String
  customer       Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productId      String?
  brand          String
  title          String
  model          String?
  serial         String?
  purchasedAt    DateTime?
  orderId        String?
  orderLineId    String?
  storeId        String?
  invoiceNo      String? // ERP FINDOC number
  invoiceUrl     String?
  warrantyMonths Int       @default(24)
  warrantyUntil  DateTime?
  extendedUntil  DateTime? // paid extended warranty
  extendedPlan   String?
  registeredBy   String    @default("order") // order | erp | manual | staff
  notes          String?
  tickets        ServiceTicket[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([customerId])
  @@index([serial])
}

/// Service / installation / delivery requests and appointments. ERP: SoftOne service job (SRVJOB) via erpJob.
model ServiceTicket {
  id          String          @id @default(cuid())
  number      String          @unique // SRV-00001
  customerId  String
  customer    Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  deviceId    String?
  device      CustomerDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  kind        String // repair | installation | delivery | pickup | appointment | warranty-claim
  status      String          @default("new") // new | scheduled | in-progress | waiting-parts | done | cancelled
  mode        String? // visit | pickup | store
  description String          @db.Text
  storeId     String?
  scheduledAt DateTime?
  slot        String? // "Πρωί 9–13"
  technician  String?
  inWarranty  Boolean         @default(true)
  cost        Decimal?        @db.Decimal(10, 2)
  erpJob      String?
  attachments Json? // media asset URLs
  timeline    Json? // [{ at, status, note, by }]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([customerId, createdAt])
  @@index([status])
}

/// Loyalty points ledger; balance = Customer.loyaltyPoints (denormalised).
model LoyaltyTransaction {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  points     Int // + earn, − spend / expire
  reason     String // order | review | referral | birthday | manual | redeem | expire | erp
  orderId    String?
  erpRef     String?
  staffId    String?
  note       String?
  at         DateTime @default(now())

  @@index([customerId, at])
}

/// Internal notes by staff (never shown to the customer).
model CustomerNote {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  staffId    String?
  staffName  String?
  text       String   @db.Text
  pinned     Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([customerId, createdAt])
}

/// Activity timeline: logins, orders, consent changes, profile edits, ERP syncs, GDPR actions.
model CustomerEvent {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  kind       String // login | register | order | consent | profile | address | device | ticket | loyalty | erp-push | erp-pull | erp-link | gdpr-export | gdpr-anonymise | note
  meta       Json?
  staffId    String?
  at         DateTime @default(now())

  @@index([customerId, at])
}

/// Favourites: a customer can keep several named lists; the default one is what the heart on cards writes to.
model WishlistList {
  id         String         @id @default(cuid())
  customerId String
  customer   Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  key        String         @default(dbgenerated("gen_random_uuid()::text")) // "default" for the main list → atomic upsert per customer
  name       String         @default("Η λίστα μου")
  isDefault  Boolean        @default(false)
  visibility String         @default("private") // private | link
  shareToken String         @unique @default(cuid())
  sort       Int            @default(0)
  items      WishlistItem[]
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@unique([customerId, key])
  @@index([customerId])
}

/// One favourite product in a list, with the price when added (price-drop badge) and per-item alert switches.
model WishlistItem {
  id               String       @id @default(cuid())
  listId           String
  list             WishlistList @relation(fields: [listId], references: [id], onDelete: Cascade)
  productId        String
  variantId        String?
  note             String?
  priority         Int          @default(0) // 0 normal · 1 high · 2 must-have
  priceAtAdd       Decimal?     @db.Decimal(10, 2)
  notifyPriceDrop  Boolean      @default(true)
  notifyBackInStock Boolean     @default(true)
  source           String       @default("web") // web | merge | admin | import
  addedAt          DateTime     @default(now())

  @@unique([listId, productId])
  @@index([productId])
}

model Cart {
  id         String     @id @default(cuid())
  customerId String?
  customer   Customer?  @relation(fields: [customerId], references: [id])
  sessionId  String?    @unique
  lines      CartLine[]
  updatedAt  DateTime   @updatedAt

  @@index([customerId])
}

model CartLine {
  id        String  @id @default(cuid())
  cartId    String
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId String
  variant   Variant @relation(fields: [variantId], references: [id])
  qty       Int
  addons    Json? // [{ serviceId, price }]

  @@index([cartId])
}

model Order {
  id          String      @id @default(cuid())
  number      String      @unique // EUR-YYYYMMDD-0000
  customerId  String?
  customer    Customer?   @relation(fields: [customerId], references: [id])
  guestEmail  String?
  status      String      @default("pending") // pending | paid | processing | shipped | ready-for-pickup | delivered | cancelled | returned
  fulfilment  String // courier | click-collect | appointment
  pickupStoreId String?
  pickupStore Store?      @relation(fields: [pickupStoreId], references: [id])
  shipping    Json // snapshot address
  invoice     Json? // { vatNumber, doy, company } when a τιμολόγιο is requested
  subtotal    Decimal     @db.Decimal(10, 2)
  shippingFee Decimal     @db.Decimal(10, 2)
  vat         Decimal     @db.Decimal(10, 2)
  total       Decimal     @db.Decimal(10, 2)
  lines       OrderLine[]
  payment     Payment?
  erpSync     ErpSync?
  returns     Return[]
  tracking    String?
  courier     String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([customerId, createdAt])
  @@index([status])
}

model OrderLine {
  id        String           @id @default(cuid())
  orderId   String
  order     Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId String
  variant   Variant          @relation(fields: [variantId], references: [id])
  title     String
  qty       Int
  unitPrice Decimal          @db.Decimal(10, 2)
  addons    OrderLineAddon[]

  @@index([orderId])
}

model OrderLineAddon {
  id          String    @id @default(cuid())
  orderLineId String
  orderLine   OrderLine @relation(fields: [orderLineId], references: [id], onDelete: Cascade)
  serviceId   String
  service     Service   @relation(fields: [serviceId], references: [id])
  price       Decimal   @db.Decimal(10, 2)
}

model Payment {
  orderId     String   @id
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method      String // card | instalments | iris | bank-transfer | cod | no-card-loan
  psp         String?
  pspRef      String?
  instalments Int      @default(1)
  status      String   @default("pending")
  scaDone     Boolean  @default(false)
  updatedAt   DateTime @updatedAt
}

/// Outbox for writing orders to the ERP with retries; the shop never blocks on the ERP.
model ErpSync {
  orderId   String   @id
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    String   @default("queued") // queued | sent | failed
  attempts  Int      @default(0)
  erpDocId  String?
  lastError String?  @db.Text
  updatedAt DateTime @updatedAt
}

model Return {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  reason    String
  lines     Json
  status    String   @default("requested")
  createdAt DateTime @default(now())

  @@index([orderId])
}

// ---------- Marketing zones (CMS) ----------

model Page {
  id        String   @id @default(cuid())
  path      String   @unique
  title     String
  zones     Zone[]
  updatedAt DateTime @updatedAt
}

model Zone {
  id      String   @id @default(cuid())
  pageId  String
  page    Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  key     String // announcement | hero | ticker | catalog | deals | services | stores | guides | newsletter | listing-top | pdp-below-buybox …
  label   String
  slot    String // above-header | header | main | pre-footer
  sortNo  Int      @default(0)
  widgets Widget[]

  @@unique([pageId, key])
}

model Widget {
  id         String    @id @default(cuid())
  zoneId     String
  zone       Zone      @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  type       String // registry key
  label      String?
  props      Json
  query      Json?
  scheduleFrom DateTime?
  scheduleTo   DateTime?
  visibility Json? // { devices, audience, regions, hideOnSaveData }
  ab         Json? // { experiment, variant, weight }
  zoneNo     Int?
  sortNo     Int       @default(0)
  version    Int       @default(1)
  updatedAt  DateTime  @updatedAt

  @@index([zoneId, sortNo])
}

model Campaign {
  id       String   @id @default(cuid())
  slug     String   @unique
  title    String
  startsAt DateTime
  /// Real expiry — the same value drives every countdown (Omnibus).
  endsAt   DateTime
  tagSlug  String?
}

model Guide {
  id        String   @id @default(cuid())
  slug      String   @unique
  kicker    String
  title     String
  excerpt   String
  body      String   @db.Text
  image     String?
  minutes   Int
  ctaLabel  String?
  ctaHref   String?
  published DateTime?
}

model Redirect {
  from String @id
  to   String
  code Int    @default(301)
}

// ---------- Back office: RBAC, audit, CMS documents ----------
// Roles and permissions are DATA (seeded), so the client's role list can
// change without code. Permission keys follow "<resource>.<action>"
// (e.g. "cms.zones.write", "orders.read", "settings.write").

model Staff {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String
  passwordHash String?      // credentials login (Auth.js); null when SSO-only
  active       Boolean      @default(true)
  storeId      String?      // store-scoped roles (member store staff)
  roles        StaffRole[]
  audits       AuditLog[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  lastLoginAt  DateTime?
}

model Role {
  id          String           @id @default(cuid())
  key         String           @unique   // e.g. "admin", "marketing"
  name        String
  description String?          @db.Text
  system      Boolean          @default(false) // cannot be deleted from the UI
  permissions RolePermission[]
  staff       StaffRole[]
  createdAt   DateTime         @default(now())
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique   // "cms.zones.write"
  group       String           // "cms" | "catalog" | "orders" | "customers" | "stores" | "settings" | "staff" | "reports"
  description String?
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model StaffRole {
  staffId String
  roleId  String
  staff   Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)
  role    Role  @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([staffId, roleId])
}

model AuditLog {
  id        String   @id @default(cuid())
  staffId   String?
  staff     Staff?   @relation(fields: [staffId], references: [id], onDelete: SetNull)
  action    String   // "cms.document.publish"
  entity    String   // "CmsDocument"
  entityId  String?
  before    Json?
  after     Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

// One table for every CMS collection (settings, copy, zones, slides,
// campaigns, brand stores, menu…): JSON documents validated per collection
// on write, with draft/published versions.
model CmsDocument {
  id          String    @id @default(cuid())
  collection  String    // "settings.site" | "copy" | "home.zones" | "hero.slides" | "campaigns" | "brand.stores" | …
  key         String    // "default" | slug | id
  data        Json      // draft
  published   Json?     // last published snapshot the storefront reads
  version     Int       @default(1)
  locale      String    @default("el")
  updatedBy   String?
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?
  createdAt   DateTime  @default(now())

  @@unique([collection, key, locale])
  @@index([collection])
}

/// Back-office settings: one row per section (general, social, analytics, softone, payments…).
/// `data` holds plain fields; `secrets` holds an AES-256-GCM encrypted JSON map of secret fields.
model Setting {
  section     String   @id
  data        Json
  secrets     String?  @db.Text
  updatedById String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}

/// Partner / integration API keys for the public API (hash stored, plain key shown once).
model ApiKey {
  id         String    @id @default(cuid())
  name       String
  prefix     String    // first 8 chars, shown in lists
  hash       String    @unique
  scopes     String[]  @default([])
  active     Boolean   @default(true)
  createdBy  String?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  expiresAt  DateTime?
}

/// Media library — folders (tree) and assets (image / video / file) stored locally or on Bunny.
model MediaFolder {
  id        String        @id @default(cuid())
  name      String
  parentId  String?
  parent    MediaFolder?  @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  MediaFolder[] @relation("FolderTree")
  assets    MediaAsset[]
  createdAt DateTime      @default(now())

  @@unique([parentId, name])
}

model MediaAsset {
  id        String       @id @default(cuid())
  kind      String       // "image" | "video" | "file"
  folderId  String?
  folder    MediaFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  filename  String       // original name
  title     String?
  alt       String?
  caption   String?
  tags      String[]     @default([])
  mime      String
  size      Int
  width     Int?
  height    Int?
  duration  Float?       // seconds (video)
  storage   String       // "local" | "bunny"
  path      String       // storage-relative path e.g. 2026/09/abc.webp
  url       String       // public URL
  thumbUrl  String?      // 480px webp (images/videos poster)
  blur      String?      // tiny base64 placeholder
  focalX    Float        @default(0.5)
  focalY    Float        @default(0.5)
  usedIn    Json?        // back-references filled by CMS documents
  createdBy String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([folderId])
  @@index([kind])
  @@index([createdAt])
}

/// Designed product stickers (SVG) — created in /admin/stickers, referenced by promo rules and campaigns.
model Sticker {
  id        String   @id @default(cuid())
  key       String   @unique
  name      String
  params    Json
  svg       String   @db.Text
  active    Boolean  @default(true)
  sort      Int      @default(0)
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// AI usage ledger (OpenRouter) — per call: feature, model, tokens, cost. Powers the daily budget guard and the dashboard tile.
model AiUsage {
  id        String   @id @default(cuid())
  day       String   // yyyy-mm-dd
  feature   String   // "advisor" | "alt-text" | "copy" | "agent" | "test"
  model     String
  tokensIn  Int      @default(0)
  tokensOut Int      @default(0)
  costUsd   Float    @default(0)   // what OpenRouter charged
  markupPct Float    @default(0)   // markup applied at call time (super-admin pricing)
  billedUsd Float    @default(0)   // costUsd × (1 + markupPct/100)
  fxRate    Float?                 // USD→EUR rate of the day (ECB)
  billedEur Float?                 // billedUsd × fxRate
  ms        Int      @default(0)
  ok        Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([day])
  @@index([feature, createdAt])
  @@index([model, day])
}

/// Per-model markup set by the super-admin; "*" = default for models not listed.
model AiModelPricing {
  model     String   @id
  markupPct Float    @default(0)
  note      String?
  updatedBy String?
  updatedAt DateTime @updatedAt
}

/// Daily FX cache (ECB via frankfurter.app): base→quote rate for a day.
model FxRate {
  day       String
  base      String
  quote     String
  rate      Float
  fetchedAt DateTime @default(now())

  @@id([day, base, quote])
}

/// Password reset with email OTP: 6-digit code (stored hashed), 10-minute expiry, max 5 attempts, evidence of the request.
model PasswordReset {
  id         String    @id @default(cuid())
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  email      String
  codeHash   String
  token      String?   @unique // issued after a correct code, single use
  expiresAt  DateTime
  attempts   Int       @default(0)
  verifiedAt DateTime?
  usedAt     DateTime?
  requestedBy String? // staffId when initiated from the back office
  ip         String?
  ipHash     String?
  userAgent  String?
  os         String?
  browser    String?
  device     String?
  createdAt  DateTime  @default(now())

  @@index([customerId, createdAt])
  @@index([email, createdAt])
}
