  fee        Float     @default(0)
  minTotal   Float?
  maxTotal   Float?
  sort       Int       @default(0)
  active     Boolean   @default(false) // off until the admin switches it on for the storefront
  s1Id       String?   @unique // PAYMENT (SODTYPE 13)
  s1Name     String?
  s1Data     Json?
  s1SyncedAt DateTime?
  s1Missing  Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

