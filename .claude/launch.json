{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "euronics-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "--port",
        "3111"
      ],
      "port": 3111,
      "autoPort": false
    },
    {
      "name": "euronics-attach",
      "url": "http://localhost:3111"
    },
    {
      "name": "euronics-dev-ar",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "AR_NO_STORE=1",
        "npm",
        "run",
        "dev",
        "--",
        "--port",
        "3111"
      ],
      "port": 3111,
      "autoPort": false
    }
  ]
}