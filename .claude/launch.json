{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "euronics-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "--port",
        "3111"
      ],
      "port": 3111,
      "autoPort": false
    },
    {
      "name": "euronics-attach",
      "url": "http://localhost:3111"
    },
    {
      "name": "euronics-dev-ar",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "AR_NO_STORE=1",
        "npm",
        "run",
        "dev",
        "--",
        "--port",
        "3111"
      ],
      "port": 3111,
      "autoPort": false
    },
    {
      "name": "euronics-prod-check",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "next",
        "start",
        "--port",
        "3222"
      ],
      "port": 3222,
      "autoPort": false
    },
    {
      "name": "b2b-engine-local",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "ALLOW_PRIVATE_NETWORK=1",
        "npm",
        "--prefix",
        "/Volumes/EXTERNALSSD/b2buronics",
        "run",
        "dev"
      ],
      "port": 3100,
      "autoPort": false
    }
  ]
}
